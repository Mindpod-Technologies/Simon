# Tenant environment — rendered by provision_tenant.py. Never commit.
SIMON_LICENSE_KEY={{LICENSE_KEY}}
SIMON_REQUIRE_LICENSE=true
SIMON_OWNER_PASSWORD_HASH={{PASSWORD_HASH}}
SIMON_WEB_DEFAULT_SESSION=owner

# LLM: hosted tier default is the frontier pool; BYOK tier overrides below.
LLM_BASE_URL={{LLM_BASE_URL}}
LLM_MODEL={{LLM_MODEL}}
LLM_MODEL_FAST={{LLM_MODEL_FAST}}
LLM_API_KEY={{LLM_API_KEY}}

# Tenant display + channels (their own Slack/Telegram/Teams credentials)
TENANT_SLUG={{TENANT_SLUG}}
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
SIMON_IDENTITY_MAP=

# Approvals and safety stay ON for hosted tenants
SIMON_APPROVALS_ENABLED=true
SIMON_ALLOW_SHELL=false
