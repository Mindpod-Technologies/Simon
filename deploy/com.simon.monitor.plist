<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.simon.monitor</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/simon/.venv/bin/python</string>
		<string>-m</string>
		<string>simon.monitor_app</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/simon</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/simon/data/logs/monitor.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/simon/data/logs/monitor.err.log</string>
</dict>
</plist>
