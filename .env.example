# LLM (any OpenAI-compatible endpoint)
# --- Local-first (recommended default): Ollama on this machine ------------
# Free, private, offline-capable. The installer pulls these models for you.
# Smart brain handles complex turns; fast brain handles simple ones (router).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=                  # empty is fine for Ollama
LLM_MODEL=gpt-oss:20b         # smart brain
LLM_MODEL_FAST=qwen3:8b       # fast brain (optional; empty = one model for all)
LLM_ROUTER_ENABLED=true

# Frontier tier (optional cloud fallback, e.g. Kimi K3 via Moonshot AI).
# Active only when LLM_FRONTIER_API_KEY is set: explicit "use kimi"
# requests route here, and local-model failures escalate here.
# LLM_FRONTIER_BASE_URL=https://api.moonshot.ai/v1
# LLM_FRONTIER_MODEL=kimi-k3
# LLM_FRONTIER_API_KEY=
# LLM_FRONTIER_REASONING_EFFORT=high
# --- Cloud alternative (uncomment, e.g. OpenAI) -----------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL_FAST=
# LLM_ROUTER_ENABLED=false
# Voice
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+0%
STT_MODEL=base            # faster-whisper model size; or 'openai' to use Whisper API
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=   # comma-separated; empty = deny all
# Slack (Socket Mode — no public endpoint needed)
SLACK_BOT_TOKEN=             # xoxb-...
SLACK_APP_TOKEN=             # xapp-... (Socket Mode enabled)
SLACK_ALLOWED_USER_IDS=      # comma-separated Slack user IDs; empty = deny all
# Microsoft Teams (requires a publicly reachable HTTPS endpoint)
TEAMS_APP_ID=                # Azure Bot / app registration client ID
TEAMS_APP_PASSWORD=          # app registration client secret
TEAMS_ALLOWED_USER_IDS=      # comma-separated AAD object IDs / Teams user IDs; empty = deny all
TEAMS_PORT=3978
SIMON_PUBLIC_BASE_URL=       # e.g. https://simon.example.com — enables TTS audio links in Teams
# Optional integrations
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Microsoft Graph mail (use when the M365 tenant has basic IMAP/SMTP auth
# disabled). Entra app registration with Mail.Read + Mail.Send *application*
# permissions + admin consent; see simon/tools/graph_mail.py docstring.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SIMON_MAILBOX=simon@mindpodtech.com
SIMON_MAIL_CHECK_ENABLED=true    # inbox watch (needs GRAPH_* above)
SIMON_MAIL_CHECK_MINUTES=5       # poll cadence
GOOGLE_CALENDAR_ICS=          # secret ICS URL for read-only calendar
HOMEASSISTANT_URL=
HOMEASSISTANT_TOKEN=
# Azure management
# Simon shells out to the Azure CLI ('az') and uses whatever identity it is
# logged in as — no credentials are stored in Simon. Install az, then:
#   Mac: az login            VPS (Azure VM): az login --identity
#   or:  az login --service-principal -u <appId> -p <secret> --tenant <tenantId>
SIMON_AZURE_ENABLED=false       # read-only Azure tools (list resources, VMs, costs, Entra users)
SIMON_AZURE_ALLOW_WRITE=false   # ALSO enables VM start/stop (deallocate)/restart — set true only if desired
# Safety
SIMON_ALLOW_SHELL=false       # shell tool disabled unless true
SIMON_WORKSPACE_DIR=./workspace
# Commercial licensing (see COMMERCIAL.md)
SIMON_LICENSE_KEY=            # SIMON-<plan>-<payload>.<sig> key from purchase; empty = free trial
SIMON_REQUIRE_LICENSE=false   # set true to refuse startup without a valid key
# Sub-agents
SIMON_SUBAGENTS_ENABLED=true      # Simon can spawn child agents to work in parallel
SIMON_SUBAGENTS_MAX_CONCURRENT=3  # max sub-agents running at once; extras queue
# Computer control (Mac)
# Grants Simon eyes + hands on this Mac. Requires the host app (Terminal /
# launchd agent) to have Accessibility, Screen Recording and Automation
# permissions in System Settings → Privacy & Security. Off by default.
SIMON_COMPUTER_USE=false
SIMON_COMPUTER_VISION=false   # describe screenshots via the LLM vision API
# Browser automation
# Simon drives his own Playwright Chromium with a persistent profile at
# ./data/browser-profile (log in once, stays logged in). Headless by default;
# set headless=false to watch him work. Requires: playwright install chromium
SIMON_BROWSER_ENABLED=true
SIMON_BROWSER_HEADLESS=true

# MCP client (Model Context Protocol)
# Simon connects to MCP servers listed in mcp.json (Claude-Desktop-style
# config) and exposes their tools as mcp_<server>_<tool>. See mcp.json.
SIMON_MCP_ENABLED=true
# SIMON_MCP_CONFIG=mcp.json     # path to the server config file
# SIMON_MCP_CALL_TIMEOUT=120    # seconds per tool call
# SIMON_MCP_START_TIMEOUT=30    # seconds per server handshake at startup
